[Unit]
Description=xone-gip headset audio buffer wedge watchdog
# 2026-09-09: Wants=graphical-session.target removed — see
# controller-legend.service for why (StopWhenUnneeded=yes cascade that
# closed every open terminal on `stop-all.sh`). After= alone still sequences
# startup correctly.
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/bash %h/ai-controller/scripts/gip-audio-watchdog.sh
WorkingDirectory=%h/ai-controller/scripts
Restart=on-failure
RestartSec=5
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
