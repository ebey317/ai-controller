[Unit]
Description=Push-to-Talk Dictation Listener (pynput)
# 2026-09-09: graphical-session.target dropped from Wants= (kept the
# voice-bridge.service app dependency) — see controller-legend.service for
# why (StopWhenUnneeded=yes cascade that closed every open terminal on
# `stop-all.sh`). After= alone still sequences startup correctly.
After=graphical-session.target voice-bridge.service
Wants=voice-bridge.service

[Service]
Type=simple
# antimicrox's uinput devices are root:input 0660. The udev rule
# (udev/90-antimicrox.rules) grants a uaccess ACL and a group fallback, but
# neither is guaranteed: uaccess depends on systemd-logind recognizing an
# active seat session, and the group fallback needs the user's session to
# have picked up `input` group membership (only happens after a fresh
# login). `sg input -c` sidesteps both — it activates the `input`
# supplementary group for this exec directly, regardless of session state,
# so PTT can read antimicrox's virtual keyboard on first boot after install
# and after every antimicrox restart, with no logout/login required.
# "type" is the standing default: a leftover CLIPBOARD toggle on
# slide_keyboard.py's on-screen keyboard silently survives service/reboot
# cycles and makes dictation look dead (transcript lands in the clipboard,
# never typed). Reset it here on every start so it can't linger unnoticed.
ExecStartPre=/bin/sh -c 'echo type > %h/.config/ai-controller/ai_controller_input_target'
ExecStart=/bin/sh -c 'sg input -c "%h/ai-controller/.venv/bin/python3 %h/ai-controller/scripts/ptt_pynput.py"'
WorkingDirectory=%h/ai-controller/scripts
Restart=on-failure
RestartSec=3
# Was KillMode=mixed, on the theory that signaling only the main process
# lets an in-flight `parec` recording finish before the rest of the cgroup
# dies. Measured wrong on the headless twin 2026-10-28: `man sg` confirms sg
# always forks+waits to run its `-c command` (never execs itself away), so
# the "main process" systemd tracks here is really sh->sg, a dumb wrapper
# that never forwards SIGTERM to the python3 grandchild actually running
# parec — stopping needed a SIGKILL escalation and python3's own
# parec-cleanup-on-SIGTERM logic (around line 1164) never ran at all.
# control-group signals every process in the cgroup directly and
# simultaneously, so python3 gets a real SIGTERM and can still clean up
# parec itself; anything left after TimeoutStopSec still gets SIGKILLed.
KillMode=control-group
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=XAUTHORITY=%h/.Xauthority
Environment=BRIDGE_URL=http://127.0.0.1:8002
# 2026-09-15: force input-only card profile after every barge-in reset.
# "combined" (headset speakers + mic) was the default in
# reset-controller-audio.sh, which re-enables the xone-gip output path on
# every reset -- the same path that wedges (172 "get buffer failed" events
# logged over 3 days) and produces an audible pop as the DAC powers back on.
# input-only never activates that output path, so the mic can't wedge and
# there's no reset-cycle pop. Trade-off: TTS no longer plays through the
# controller headset (see AUDIO_OUTPUT in config.env for where it goes
# instead) -- Elijah's explicit choice over keeping headset audio.
Environment=CONTROLLER_AUDIO_PROFILE=input

[Install]
WantedBy=default.target
