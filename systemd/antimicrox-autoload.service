[Unit]
Description=AntiMicroX Controller Auto-Loader (window-focus profile switcher)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/bin/bash %h/scripts/controller-profile-switcher.sh
ExecStopPost=/usr/bin/pkill -f antimicrox.AppImage
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
