[Unit]
Description=Voice Bridge — PTT → Groq Whisper → TTS
# 2026-09-09: Wants=graphical-session.target removed — see
# controller-legend.service for why (StopWhenUnneeded=yes cascade that
# closed every open terminal on `stop-all.sh`). After= alone still sequences
# startup correctly.
After=graphical-session.target

[Service]
Environment=AI_CONTROLLER_DIR=%h/ai-controller
EnvironmentFile=%h/.config/ai-controller/config.env
ExecStart=%h/ai-controller/.venv/bin/python3 %h/ai-controller/scripts/voice_bridge.py
WorkingDirectory=%h/ai-controller
Restart=on-failure
RestartSec=3
# See ptt-pynput.service: mixed lets an in-flight TTS/STT subprocess finish
# on stop instead of the default control-group kill severing it immediately.
KillMode=mixed

[Install]
WantedBy=default.target
