[Unit]
Description=A-button double-tap -> Enter (drag-safe, adds to existing click/drag mapping)
# 2026-09-09: Wants=graphical-session.target removed — see
# controller-legend.service for why (StopWhenUnneeded=yes cascade that
# closed every open terminal on `stop-all.sh`). After= alone still sequences
# startup correctly.
After=graphical-session.target antimicrox-autoload.service

[Service]
Type=simple
ExecStart=%h/ai-controller/.venv/bin/python3 %h/ai-controller/scripts/a_button_double_tap_enter.py
Restart=on-failure
RestartSec=3
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
