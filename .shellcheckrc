# ShellCheck configuration file
# Disable SC2034 (var appears unused) - often used in sourced files
SC2034:ignore

# Disable SC2154 (var is referenced but not assigned) - common in config files
SC2154:ignore

# Disable SC2148 (files without shebang) - some files are sourced, not executed
SC2148:ignore

# Disable SC2164 (cd in subshell) - common in scripts that source other scripts
SC2164:ignore

# Disable SC2086 (double quote to prevent word splitting) - sometimes intentional
SC2086:ignore

# Enable SC2155 (declare and assign separately) - good practice
SC2155:enable

# Enable SC1090 (source not followed) - warn about sourcing files without full path
SC1090:enable

# Enable SC1091 (source file not found) - warn about missing sourced files
SC1091:enable

# Disable SC2001 (use sed instead of parameter expansion) - sometimes clearer with parameter expansion
SC2001:ignore

# Disable SC2002 (useless cat) - sometimes needed for clarity
SC2002:ignore

# Disable SC2046 (quote to prevent word splitting) - sometimes intentional
SC2046:ignore

# Disable SC2039 (variable is undefined) - common in scripts that source config files
SC2039:ignore