# ShellCheck configuration file
#
# Syntax note: shellcheck only accepts `disable=SCxxxx` / `enable=SCxxxx`
# directives here. The previous `SCxxxx:ignore` / `SCxxxx:enable` form was
# never valid — shellcheck rejected the whole file with SC1134 and reported
# that error against every single script, so `shellcheck scripts/*.sh` failed
# unconditionally instead of linting anything.

# SC2034 — var appears unused; common in sourced files.
# SC2154 — var referenced but not assigned; common in config files.
# SC2148 — file has no shebang; some files are sourced, not executed.
# SC2164 — `cd` without failure handling; common in scripts sourcing others.
# SC2086 — unquoted expansion; sometimes deliberate.
# SC2001 — "use sed instead of parameter expansion"; expansion is sometimes clearer.
# SC2002 — "useless cat"; sometimes kept for clarity.
# SC2046 — unquoted command substitution; sometimes deliberate.
# SC2039 — undefined variable in POSIX-ish scripts that source config files.
disable=SC2034,SC2154,SC2148,SC2164,SC2086,SC2001,SC2002,SC2046,SC2039

# Surfaces worth keeping on.
enable=SC2155,SC1090,SC1091

# Follow sourced files so SC1090/SC1091 can actually resolve them.
external-sources=true
