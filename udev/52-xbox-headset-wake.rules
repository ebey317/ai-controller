# Auto-wake the Xbox controller headset mic on connect (no manual 3.5mm reseat).
# Fires the wake service via systemd (non-blocking — never stalls udev).
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="0b12", TAG+="systemd", RUN+="/bin/systemctl --no-block start xbox-headset-wake.service"
