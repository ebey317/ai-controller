# AI Controller configuration
# Copy to ~/.config/ai-controller/config.env and fill in your values
AI_CONTROLLER_DIR=/home/elijah/ai-controller
GROQ_API_KEY=your_groq_api_key_here

# Optional: override default PulseAudio devices
# AUDIO_INPUT=alsa_input.usb-Microsoft_Controller_....mono-fallback
# AUDIO_OUTPUT=alsa_output.usb-Microsoft_Controller_....stereo-fallback

# Optional: Voice bridge settings
# VOICE_BRIDGE_API_KEY=your_api_key_here
# VOICE_BRIDGE_LLM_MODEL=llama-3.3-70b-versatile
# VOICE_BRIDGE_GROQ_TIMEOUT=30
# VOICE_BRIDGE_CLAF_TIMEOUT=120
# VOICE_BRIDGE_MAX_TRANSCRIPT_CHARS=2000