# AI Controller Profile — environment template
# Copy to ~/.config/ai-controller/config.env (already gitignored)
# and fill in real values.

# ── Voice bridge ──────────────────────────────────────────────────────────────
# Groq API key for Whisper STT and LLM responses
GROQ_API_KEY=gsk_...

# CLAF proxy URL (default: local orchestrator)
CLAF_URL=http://localhost:8000

# Optional API key to lock the voice bridge endpoint
VOICE_BRIDGE_API_KEY=

# Timeouts (seconds)
VOICE_BRIDGE_GROQ_TIMEOUT=30
VOICE_BRIDGE_CLAF_TIMEOUT=120
VOICE_BRIDGE_MAX_TRANSCRIPT_CHARS=2000

# LLM model used for voice responses (Groq free tier)
VOICE_BRIDGE_LLM_MODEL=llama-3.3-70b-versatile

# ── Push-to-talk ──────────────────────────────────────────────────────────────
# URL of the voice bridge endpoint
BRIDGE_URL=http://127.0.0.1:8002

# tmux session name for Sensei injection
SENSEI_SESSION=focus-engine
