<?xml version="1.0" encoding="UTF-8"?>
<gamecontroller configversion="19" appversion="3.5.1">
    <!--The SDL name for a joystick is included for informational purposes only.-->
    <sdlname>Xbox Series X Controller</sdlname>
    <!--The Unique ID for a joystick is included for informational purposes only.-->
    <uniqueID>03009daa5e040000120b00000b05000011182834</uniqueID>
    <stickAxisAssociation index="1" xAxis="1" yAxis="2"/>
    <stickAxisAssociation index="2" xAxis="3" yAxis="4"/>
    <vdpadButtonAssociations index="1">
        <vdpadButtonAssociation axis="0" button="12" direction="1"/>
        <vdpadButtonAssociation axis="0" button="13" direction="4"/>
        <vdpadButtonAssociation axis="0" button="14" direction="8"/>
        <vdpadButtonAssociation axis="0" button="15" direction="2"/>
    </vdpadButtonAssociations>
    <names>
        <controlstickname index="1">Stick 1</controlstickname>
        <controlstickname index="2">Stick 2</controlstickname>
    </names>
    <sets>
        <set index="1">
            <!-- Left stick = mouse cursor movement -->
            <stick index="1">
                <deadZone>6500</deadZone>
                <maxZone>28000</maxZone>
                <stickbutton index="1">
                    <slots><slot><code>1</code><mode>mousemovement</mode></slot></slots>
                </stickbutton>
                <stickbutton index="3">
                    <slots><slot><code>4</code><mode>mousemovement</mode></slot></slots>
                </stickbutton>
                <stickbutton index="5">
                    <slots><slot><code>2</code><mode>mousemovement</mode></slot></slots>
                </stickbutton>
                <stickbutton index="7">
                    <slots><slot><code>3</code><mode>mousemovement</mode></slot></slots>
                </stickbutton>
            </stick>
            <!-- Right stick = scroll wheel -->
            <stick index="2">
                <deadZone>6500</deadZone>
                <maxZone>28000</maxZone>
                <stickbutton index="1">
                    <slots><slot><code>4</code><mode>mousebutton</mode></slot></slots>
                </stickbutton>
                <stickbutton index="5">
                    <slots><slot><code>5</code><mode>mousebutton</mode></slot></slots>
                </stickbutton>
            </stick>
            <!-- LT = unused | RT = F13 push-to-talk -->
            <trigger index="5">
                <throttle>positivehalf</throttle>
            </trigger>
            <trigger index="6">
                <throttle>positivehalf</throttle>
                <triggerbutton index="2">
                    <slots>
                        <slot>
                            <code>0x100003c</code>
                            <mode>keyboard</mode>
                        </slot>
                    </slots>
                </triggerbutton>
            </trigger>
            <!-- D-pad: Up/Down = Page Up/Down, Left/Right = arrow keys -->
            <dpad index="1">
                <dpadbutton index="1">
                    <slots><slot><code>0x1000016</code><mode>keyboard</mode></slot></slots>
                </dpadbutton>
                <dpadbutton index="2">
                    <slots><slot><code>0x1000014</code><mode>keyboard</mode></slot></slots>
                </dpadbutton>
                <dpadbutton index="4">
                    <slots><slot><code>0x1000017</code><mode>keyboard</mode></slot></slots>
                </dpadbutton>
                <dpadbutton index="8">
                    <slots><slot><code>0x1000012</code><mode>keyboard</mode></slot></slots>
                </dpadbutton>
            </dpad>
            <!-- Face buttons: A=Click(double=open, hold=keyboard) B=Back X=Delete Y=Paste -->
            <button index="1">
                <slots>
                    <slot><code>1</code><mode>mousebutton</mode></slot>
                    <slot><code>600</code><mode>hold</mode></slot>
                    <slot><mode>execute</mode><path>/usr/bin/onboard</path></slot>
                </slots>
            </button>
            <button index="2">
                <slots>
                    <slot><code>0x1000023</code><mode>keyboard</mode></slot>
                    <slot><code>0x1000012</code><mode>keyboard</mode></slot>
                </slots>
            </button>
            <button index="3">
                <slots><slot><code>0x1000007</code><mode>keyboard</mode></slot></slots>
            </button>
            <button index="4">
                <slots>
                    <slot><code>0x1000021</code><mode>keyboard</mode></slot>
                    <slot><code>0x56</code><mode>keyboard</mode></slot>
                </slots>
            </button>
            <!-- Back=Delete  Guide=onboard  Start=Middle Click -->
            <button index="5">
                <slots><slot><code>0x1000007</code><mode>keyboard</mode></slot></slots>
            </button>
            <button index="6">
                <slots>
                    <slot><mode>execute</mode><path>/usr/bin/onboard</path></slot>
                </slots>
            </button>
            <button index="7">
                <slots><slot><code>3</code><mode>mousebutton</mode></slot></slots>
            </button>
            <!-- L3=F13(PTT)  R3=Super  LB=Alt+Tab  RB=Right Click -->
            <button index="8">
                <slots><slot><code>0x100003c</code><mode>keyboard</mode></slot></slots>
            </button>
            <button index="9">
                <slots><slot><code>0x1000022</code><mode>keyboard</mode></slot></slots>
            </button>
            <button index="10">
                <slots>
                    <slot><code>0x1000023</code><mode>keyboard</mode></slot>
                    <slot><code>0x1000001</code><mode>keyboard</mode></slot>
                </slots>
            </button>
            <button index="11">
                <slots><slot><code>2</code><mode>mousebutton</mode></slot></slots>
            </button>
        </set>
    </sets>
</gamecontroller>
