__pycache__/
*.pyc
.superpowers/
*.onnx
voices/*/en_US-*.onnx.json

.venv/
logs/*.log
*.tar.gz
*.tar
*.bak.*
*.bak

# Test/coverage artifacts (htmlcov/ self-ignores via the .gitignore that
# coverage.py writes into it; these two do not).
.coverage
.coverage.*
coverage.xml

# Secrets — real config lives in ~/.config/ai-controller/ and its backups/.
# Never track it; snapshots/ carries a redacted template instead.
config.env
*.env
!*.env.template
